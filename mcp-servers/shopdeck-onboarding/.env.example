# Copy to .env and fill in, or export these in your shell before starting the
# server. Credentials are NOT set here -- BigQuery auth comes from Application
# Default Credentials (see README).

# Required. The GCP project holding the dataset.
SHOPDECK_BQ_PROJECT=blitzscale-prod-project

# Dataset name.
SHOPDECK_BQ_DATASET=nushop

# MUST match the dataset's actual region. Run `npm run check` -- it reads the
# real region and tells you the value to put here. A mismatch produces
# confusing "Not found: Job" errors rather than a clear failure.
SHOPDECK_BQ_LOCATION=US

# Optional guards.
# SHOPDECK_MAX_BYTES_BILLED=21474836480   # 20 GB ceiling per query
# SHOPDECK_DEFAULT_LOOKBACK_MONTHS=6
# SHOPDECK_MAX_ROWS=500
